<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.dapoer_mbg.view.LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/actionDashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.dapoer_mbg.view.DashboardFragment"
        tools:layout="@layout/fragment_dashboard" >
        <action
            android:id="@+id/actionCreateHabitFragment"
            app:destination="@id/createHabitFragment" />
        <action
            android:id="@+id/actionEditHabitFragment"
            app:destination="@id/editHabitFragment"/>
    </fragment>
    <fragment
        android:id="@+id/createHabitFragment"
        android:name="com.example.dapoer_mbg.view.CreateHabitFragment"
        android:label="Create New Habit"
        tools:layout="@layout/fragment_create_habit">

        <argument
            android:name="habitId"
            app:argType="integer"
            android:defaultValue="-1"/>
    </fragment>

    <fragment
        android:id="@+id/editHabitFragment"
        android:name="com.example.dapoer_mbg.view.CreateHabitFragment"
        android:label="Update Habit"
        tools:layout="@layout/fragment_create_habit">

        <argument
            android:name="habitId"
            app:argType="integer"/>
    </fragment>
</navigation>